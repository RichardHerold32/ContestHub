{
  "name": "server",
  "version": "1.0.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "pretypecheck": "npm run db:generate",
    "typecheck": "tsc --noEmit",
    "prebuild": "npm run db:generate",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "predb:check": "npm run build",
    "db:check": "node dist/scripts/check-db.js"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "18.0.10",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "8.23.1",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
