generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum ContestSource {
  CODEFORCES
  MANUAL
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         UserRole   @default(USER)
  createdAt    DateTime   @default(now())
  sessions     Session[]
  bookmarks    Bookmark[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Contest {
  id          String        @id @default(cuid())
  source      ContestSource
  externalId  String
  title       String
  description String?
  category    String        @default("CODING")
  startsAt    DateTime
  endsAt      DateTime?
  sourceUrl   String
  isPublished Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  bookmarks   Bookmark[]

  @@unique([source, externalId])
  @@index([startsAt])
  @@index([category, startsAt])
}

model Bookmark {
  userId    String
  contestId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contest   Contest  @relation(fields: [contestId], references: [id], onDelete: Cascade)

  @@id([userId, contestId])
}
